---
import SiteLayout from './SiteLayout.astro';
import PresetForm from './PresetForm.astro';
import { localize, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${basePath}/${locale === 'ru' ? 'ru/' : ''}`;
---

<SiteLayout {locale} preset>
  <section
    class="preset-section preset-page section-space page-width"
    aria-labelledby="preset-title"
  >
    <div class="preset-intro">
      <p class="eyebrow">
        {t('Optional preferences', 'Необязательные предпочтения')}
      </p>
      <h1 id="preset-title">
        {t('Save your preferences', 'Сохраните предпочтения')}
      </h1>
      <p>
        {t(
          'Reuse your workflow and constraints in similar projects. Pass preset.yaml to your agent; it will inspect each project again and ask you to approve its plan.',
          'Сохраните привычный процесс и ограничения для похожих проектов. Передайте preset.yaml агенту — каждый проект он изучит заново и согласует с вами план.',
        )}
      </p>
      <p class="privacy-note">
        {t(
          'Generated in your browser. No answers are sent. Keep secrets out of the preset.',
          'Создаётся в вашем браузере. Ответы никуда не отправляются. Не добавляйте секреты в пресет.',
        )}
      </p>
      <p>
        <a class="text-link" href={`${home}#start`}>
          {t('← Back to get started', '← К первому запуску')}
        </a>
      </p>
    </div>
    <PresetForm {locale} expanded />
  </section>
</SiteLayout>
