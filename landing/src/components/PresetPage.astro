---
import SiteLayout from './SiteLayout.astro';
import PresetForm from './PresetForm.astro';
import { localize, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${basePath}/${locale === 'ru' ? 'ru/' : ''}`;
---

<SiteLayout {locale} preset>
  <section
    class="preset-section preset-page section-space page-width"
    aria-labelledby="preset-title"
  >
    <div class="preset-intro">
      <p class="eyebrow">
        {t('For future projects', 'Для следующих проектов')}
      </p>
      <h1 id="preset-title">
        {t('Save your agent settings', 'Сохраните настройки работы с агентом')}
      </h1>
      <p>
        {t(
          'Describe your workflow and constraints. Download preset.yaml and give it to your agent in the next project. It will read the project again and ask you to approve a plan before making changes.',
          'Укажите, как вы привыкли работать и какие ограничения нужно соблюдать. Скачайте preset.yaml и передайте агенту в следующем проекте. Перед изменениями он заново изучит проект и согласует с вами план.',
        )}
      </p>
      <p class="privacy-note">
        {t(
          'The file is created in your browser; answers are not sent anywhere. Do not include passwords, tokens or other secrets.',
          'Файл создаётся в браузере, ответы никуда не отправляются. Не добавляйте пароли, токены и другие секреты.',
        )}
      </p>
      <p>
        <a class="text-link" href={`${home}#start`}>
          {t('← Back to get started', '← К первому запуску')}
        </a>
      </p>
    </div>
    <PresetForm {locale} expanded />
  </section>
</SiteLayout>
