---
import SiteLayout from './SiteLayout.astro';
import ProjectPreview from './ProjectPreview.astro';
import Installation from './Installation.astro';
import InteractionExamples from './InteractionExamples.astro';
import Features from './astrowind/Features.astro';
import FAQs from './astrowind/FAQs.astro';
import { localize, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const repository = 'https://github.com/warbr1ng3r/tibicen';
const installationGuide = `${repository}/blob/main/docs/INSTALLATION.md`;
const release = `${repository}/releases/tag/v1.8.2`;
const presetPath = `${basePath}/${locale === 'ru' ? 'ru/' : ''}preset/`;
const scenarios = [
  {
    title: t('Set up this project', 'Настроить проект'),
    description: t(
      'For a project with no agent instructions yet',
      'Для проекта, в котором ещё нет инструкций для агента',
    ),
    prompt: t(
      'Read ~/.agents/skills/tibicen-init/SKILL.md and follow its instructions. Set this project up for my coding agent.',
      'Прочитай ~/.agents/skills/tibicen-init/SKILL.md и следуй его инструкциям. Подготовь этот проект для моего агента.',
    ),
  },
  {
    title: t(
      'Update existing instructions',
      'Обновить существующие инструкции',
    ),
    description: t(
      'For a project with outdated or conflicting rules',
      'Для проекта с устаревшими или противоречащими друг другу правилами',
    ),
    prompt: t(
      'Read ~/.agents/skills/tibicen-adopt/SKILL.md and follow its instructions. Check the project instructions and fix what is outdated.',
      'Прочитай ~/.agents/skills/tibicen-adopt/SKILL.md и следуй его инструкциям. Проверь инструкции проекта и исправь устаревшее.',
    ),
  },
];
const questions = [
  {
    title: t('Which coding agents can I use?', 'Какие агенты подходят?'),
    description: t(
      'Use an agent that can read project files and run commands with Node. Ask it to read the installed SKILL.md; automatic discovery is not required. The model and provider depend on your agent settings. Check Requirements and compatibility for a link to what was tested in the published release and its limits.',
      'Подойдёт агент, который читает файлы проекта и запускает команды через Node. Попросите его прочитать установленный SKILL.md: автоматическое обнаружение для этого не требуется. Модель и провайдер зависят от настроек вашего агента. Перед запуском проверьте раздел «Требования и совместимость»: там есть ссылка на проверки и ограничения релиза.',
    ),
  },
  {
    title: t(
      'Do I need another account or API key?',
      'Нужен отдельный аккаунт или API-ключ?',
    ),
    description: t(
      'Tibicen runs inside your coding agent, so it needs no separate account or API key. Your agent and connected services may require their own accounts and payment.',
      'Для Tibicen не нужны отдельный аккаунт или API-ключ: он работает внутри вашего агента. Для самого агента и подключаемых сервисов могут понадобиться свои аккаунты и оплата.',
    ),
  },
  {
    title: t(
      'What happens to existing project files?',
      'Что произойдёт с существующими файлами?',
    ),
    description: t(
      'Tibicen changes only the agent setup files you approve. Application code, data, existing package files and CI stay unchanged. Installing tools and running project commands require your approval. Tibicen creates no commits and does not run in the background after it finishes.',
      'Tibicen меняет только согласованные файлы настройки агента. Код приложения, данные, существующие файлы пакетов и CI остаются без изменений. Установка инструментов и запуск команд проекта требуют вашего согласия. Tibicen не создаёт коммиты и не работает в фоне после завершения.',
    ),
  },
  {
    title: t('Where does my data go?', 'Куда отправляются данные?'),
    description: t(
      'The preset is created in your browser; form answers are not sent anywhere. Project data is handled under your agent provider’s policies. Tibicen uses external sources to research components. Keep passwords, tokens and other secrets out of presets.',
      'Пресет создаётся в браузере; ответы из формы никуда не отправляются. При работе с проектом данные обрабатываются по правилам провайдера вашего агента. Для поиска компонентов Tibicen обращается к внешним источникам. Не добавляйте в пресет пароли, токены и другие секреты.',
    ),
  },
  {
    title: t(
      'How do updates and removal work?',
      'Как работают обновление и удаление?',
    ),
    description: t(
      'Tibicen updates when you ask; it does not update in the background. If you edited skill files, save a copy before reinstalling your chosen version. Removing the skills does not undo changes already made to a project. The guide explains how to update or remove Tibicen.',
      'Tibicen обновляется по вашей команде, без фонового обновления. Если вы редактировали файлы скиллов, сохраните копию перед переустановкой выбранной версии. Удаление скиллов не отменяет уже внесённые изменения в проекте. Как обновить или удалить Tibicen, описано в инструкции.',
    ),
  },
];
const geometry = [
  ['waves', t('Contour wave', 'Контурная волна')],
  ['cubes', t('Wireframe cubes', 'Каркасные кубы')],
  ['scaffold', t('Scaffolding', 'Строительные леса')],
  ['truss', t('Flat graph', 'Плоский граф')],
  ['lattice', t('Modular lattice', 'Модульная решётка')],
  ['clusters', t('Cluster network', 'Сеть центров')],
  ['dag', t('Branching graph', 'Граф с ветвлениями')],
];
---

<SiteLayout {locale}>
  <nav
    class="geometry-preview page-width"
    aria-label={t('Compare background options', 'Сравнение вариантов фона')}
    hidden
  >
    <span>{t('Background options', 'Варианты фона')}</span>
    {geometry.map(([value, label]) => (
      <a href={`?preview=geometry&geometry=${value}`} data-geometry={value}>
        {label}
      </a>
    ))}
  </nav>
  <div class="hero-surface" data-geometry="truss">
    <section class="hero page-width" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          {t(
            'Project setup for coding agents',
            'Настройка проекта для агентов',
          )}
        </p>
        <h1 id="hero-title">
          {t('Set up your project for ', 'Подготовьте проект к работе ')}
          <span>{t('your coding agent', 'с агентом')}</span>
        </h1>
        <p class="hero-description">
          {t(
            'Tibicen reads your project and proposes instructions and tools for your agent. Changes begin after you approve the plan.',
            'Tibicen изучит проект и предложит инструкции и инструменты для агента. Изменения внесёт после вашего согласия.',
          )}
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#start">
            {t('Install Tibicen', 'Установить Tibicen')}{' '}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="#result">
            {t('See a walkthrough', 'Посмотреть пример')}{' '}
            <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="hero-note">
          <span class="status-dot" aria-hidden="true"></span>
          Tibicen · 1.8.2 · MIT
        </p>
      </div>
      <ProjectPreview {locale} />
    </section>
  </div>

  <section class="start-section" id="start" aria-labelledby="start-title">
    <div class="page-width start-grid start-install">
      <div class="start-copy">
        <p class="eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          {t('First run', 'Первый запуск')}
        </p>
        <h2 id="start-title">{t('Install Tibicen', 'Установите Tibicen')}</h2>
        <p>
          {t(
            'Installation requires Node ≥22.20 and Git. To use Tibicen, your agent needs access to project files. No separate account is needed. You can create a preset later.',
            'Для установки нужны Node ≥22.20 и Git, для работы — агент с доступом к файлам проекта. Регистрироваться отдельно не нужно. Пресет можно создать позже.',
          )}
        </p>
        <p class="support-note">
          {t(
            'Automatic loading is experimental. On Windows, run project commands manually.',
            'Автоматическая загрузка скиллов пока экспериментальная. На Windows запускайте команды проекта вручную.',
          )}
        </p>
        <details class="start-help" id="compatibility">
          <summary>
            {t('Requirements and compatibility', 'Требования и совместимость')}
          </summary>
          <p>
            {t(
              'Your agent needs access to the whole skill folder and must be able to run its commands with Node. If it cannot run commands, you’ll need to carry out the approved steps yourself. You choose the model and provider in your agent. Automatic discovery and skill behavior depend on the environment. The release notes explain what was tested.',
              'Агенту нужен доступ ко всей папке скилла и возможность запускать его команды через Node. Если агент не умеет выполнять команды, согласованные шаги придётся выполнить вам. Модель и провайдера вы выбираете в своём агенте. Автоматическое обнаружение и работа скилла зависят от используемой среды. Что именно проверено, указано в описании релиза.',
            )}
          </p>
          <a href={release}>
            {t('Release scope and limits', 'Проверки и ограничения релиза')} ↗
          </a>
        </details>
      </div>
      <Installation {locale} />
    </div>
    <Features
      id="scenarios"
      {locale}
      tagline={t(
        '2. Send a request to your agent',
        '2. Отправьте запрос агенту',
      )}
      title={t(
        'Open the project in your agent',
        'Откройте проект в своём агенте',
      )}
      subtitle={t(
        'Choose a request and send it to your agent in the project chat. Tibicen reads the files and shows you a change plan.',
        'Выберите подходящий запрос и отправьте его агенту в чате проекта. Tibicen изучит файлы и покажет план изменений.',
      )}
      items={scenarios}
    />
    <details class="start-help page-width first-session" id="skill-help">
      <summary>
        {t('The agent cannot find the skill?', 'Агент не находит скилл?')}
      </summary>
      <p>
        {t(
          'Ask your agent to read SKILL.md at the path in the request. If it does not understand ~, use the full path to your home folder. Keep the whole skill folder: it needs the included instructions and scripts. This loads the skill manually; automatic discovery depends on your agent.',
          'Попросите агента прочитать SKILL.md по пути из запроса. Если он не понимает ~, укажите полный путь к домашней папке. Сохраните всю папку скилла: ему нужны вложенные инструкции и скрипты. Такой способ загружает скилл вручную; автоматическое обнаружение зависит от агента.',
        )}
      </p>
      <a href={installationGuide}>
        {t('Installation and troubleshooting', 'Установка и решение проблем')} ↗
      </a>
    </details>
  </section>
  <InteractionExamples {locale} />
  <FAQs
    id="faq"
    tagline={t('Before your first run', 'Перед первым запуском')}
    title={t('What to know', 'Что нужно знать')}
    items={questions}
  />
  <section
    id="preset"
    class="preset-link page-width"
    aria-labelledby="preset-title"
  >
    <div>
      <p class="eyebrow">
        {t('For your next projects', 'Для следующих проектов')}
      </p>
      <h2 id="preset-title">
        {t(
          'Save your setup for future projects',
          'Сохраните настройки для следующих проектов',
        )}
      </h2>
      <p>
        {t(
          'Save your workflow and constraints in a preset. Give it to your agent in the next project: it will use those preferences, read the files and propose a new plan.',
          'Сохраните привычный порядок работы и ограничения в пресет. В следующем проекте передайте его агенту: тот учтёт настройки, заново изучит файлы и предложит план.',
        )}
      </p>
    </div>
    <a class="button button-secondary" href={presetPath}>
      {t('Create a preset', 'Создать пресет')} <span aria-hidden="true">↗</span>
    </a>
  </section>
</SiteLayout>
<script src="../scripts/background.ts"></script>
