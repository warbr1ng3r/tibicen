---
import SiteLayout from './SiteLayout.astro';
import ProjectPreview from './ProjectPreview.astro';
import Installation from './Installation.astro';
import InteractionExamples from './InteractionExamples.astro';
import Features from './astrowind/Features.astro';
import FAQs from './astrowind/FAQs.astro';
import { localize, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const repository = 'https://github.com/warbr1ng3r/tibicen';
const installationGuide = `${repository}/blob/main/docs/INSTALLATION.md`;
const release = `${repository}/releases/tag/v1.5.1`;
const presetPath = `${basePath}/${locale === 'ru' ? 'ru/' : ''}preset/`;
const scenarios = [
  {
    title: t('Set up this project', 'Настроить проект'),
    description: t(
      'Start here if the project has no agent instructions yet.',
      'Если в проекте ещё нет инструкций для агента.',
    ),
    prompt: t(
      'Read ~/.agents/skills/tibicen-init/SKILL.md and follow its instructions. Set this project up for my coding agent.',
      'Прочитай ~/.agents/skills/tibicen-init/SKILL.md и следуй его инструкциям. Подготовь этот проект для моего агента.',
    ),
  },
  {
    title: t('Fix the existing setup', 'Привести настройку в порядок'),
    description: t(
      'Keep useful rules and correct what is outdated or conflicting.',
      'Сохранить полезные правила и исправить устаревшее или противоречивое.',
    ),
    prompt: t(
      'Read ~/.agents/skills/tibicen-adopt/SKILL.md and follow its instructions. Check the project instructions and fix what is outdated.',
      'Прочитай ~/.agents/skills/tibicen-adopt/SKILL.md и следуй его инструкциям. Проверь инструкции проекта и исправь устаревшее.',
    ),
  },
];
const questions = [
  {
    title: t(
      'Can I use another coding agent?',
      'Можно использовать другого агента?',
    ),
    description: t(
      'Use a host that can read project files and run the required Node commands. Explicitly open the installed SKILL.md; a catalog entry or automatic discovery is not required. Your host chooses the model and provider. Check Requirements and compatibility for the narrower observations on the published release.',
      'Нужна среда, которая читает файлы проекта и запускает нужные Node-команды. Явно откройте установленный SKILL.md; запись в каталоге и автоматическое обнаружение не обязательны. Модель и провайдера выбирает ваша среда. Наблюдения для опубликованного релиза перечислены в разделе «Требования и совместимость».',
    ),
  },
  {
    title: t(
      'Do I need another account or API key?',
      'Нужен отдельный аккаунт или API-ключ?',
    ),
    description: t(
      'Tibicen runs inside your usual coding agent and needs no separate account or API key. Your agent and any selected external services keep their own authentication and costs.',
      'Tibicen работает внутри привычного агента, отдельный аккаунт или API-ключ не нужен. У агента и выбранных внешних сервисов остаются собственные авторизация и стоимость.',
    ),
  },
  {
    title: t(
      'What happens to existing project files?',
      'Что произойдёт с существующими файлами?',
    ),
    description: t(
      'Only approved agent infrastructure changes. Application source, data, existing package manifests and CI are preserved. Installations and project commands require approval. No commits or persistent Tibicen process are created.',
      'Меняется только согласованная агентская инфраструктура. Код приложения, данные, существующие package-файлы и CI сохраняются. Установка и проектные команды требуют согласия. Коммиты и постоянный процесс Tibicen не создаются.',
    ),
  },
  {
    title: t('Where does my data go?', 'Куда отправляются данные?'),
    description: t(
      'The optional preset is generated in your browser without sending answers. Project work follows your agent provider’s data rules. Component research uses external sources; keep secrets out of presets.',
      'Необязательный пресет создаётся в браузере без отправки ответов. Для работы с проектом действуют правила обработки данных вашего агента. Поиск компонентов использует внешние источники; секреты в пресет не добавляйте.',
    ),
  },
  {
    title: t(
      'How do updates and removal work?',
      'Как работают обновление и удаление?',
    ),
    description: t(
      'Updates are explicit; there is no background updater. Back up local skill edits before reinstalling a pinned release. Removing the skills does not undo approved project changes. The linked guide covers both operations.',
      'Обновления запускаются явно, фонового обновления нет. Перед переустановкой закреплённого релиза сохраните локальные правки скиллов. Удаление скиллов не отменяет согласованные изменения проекта. Обе операции описаны в инструкции по ссылке.',
    ),
  },
];
const geometry = [
  ['waves', t('Contour wave', 'Контурная волна')],
  ['cubes', t('Wireframe cubes', 'Каркасные кубы')],
  ['scaffold', t('Scaffolding', 'Строительные леса')],
  ['truss', t('Flat graph', 'Плоский граф')],
  ['lattice', t('Modular lattice', 'Модульная решётка')],
  ['clusters', t('Cluster network', 'Сеть центров')],
  ['dag', t('Branching graph', 'Граф с ветвлениями')],
];
---

<SiteLayout {locale}>
  <nav
    class="geometry-preview page-width"
    aria-label={t('Compare background options', 'Сравнение вариантов фона')}
    hidden
  >
    <span>{t('Background options', 'Варианты фона')}</span>
    {geometry.map(([value, label]) => (
      <a href={`?preview=geometry&geometry=${value}`} data-geometry={value}>
        {label}
      </a>
    ))}
  </nav>
  <div class="hero-surface" data-geometry="truss">
    <section class="hero page-width" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          {t(
            'Project setup for coding agents',
            'Настройка проекта для агентов',
          )}
        </p>
        <h1 id="hero-title">
          {t('Set up your project for ', 'Подготовьте проект к работе ')}
          <span>{t('AI coding.', 'с агентом.')}</span>
        </h1>
        <p class="hero-description">
          {t(
            'Project instructions and useful tools, set up for your coding agent. Review the plan before anything changes.',
            'Инструкции и нужные инструменты под ваш проект и агента. Сначала посмотрите и согласуйте план изменений.',
          )}
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#start">
            {t('Install Tibicen', 'Установить Tibicen')}{' '}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="#result">
            {t('See a walkthrough', 'Посмотреть пример')}{' '}
            <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="hero-note">
          <span class="status-dot" aria-hidden="true"></span>
          Tibicen · 1.5.1 · MIT
        </p>
      </div>
      <ProjectPreview {locale} />
    </section>
  </div>

  <section class="start-section" id="start" aria-labelledby="start-title">
    <div class="page-width start-grid start-install">
      <div class="start-copy">
        <p class="eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          {t(
            'Install, then ask your agent',
            'Установите и дайте задачу агенту',
          )}
        </p>
        <h2 id="start-title">{t('Get started', 'Начните работу')}</h2>
        <p>
          {t(
            'Use your usual coding agent with file access. You need Node ≥22.20 and Git for installation. No extra account or preset.',
            'Работайте в привычном агенте с доступом к файлам. Для установки нужны Node ≥22.20 и Git. Дополнительный аккаунт и пресет не нужны.',
          )}
        </p>
        <p class="support-note">
          {t(
            'Automatic loading is experimental. On Windows, run project commands manually.',
            'Автозагрузка экспериментальна. На Windows запускайте команды проекта вручную.',
          )}
        </p>
        <details class="start-help" id="compatibility">
          <summary>
            {t('Requirements and compatibility', 'Требования и совместимость')}
          </summary>
          <p>
            {t(
              'Your agent must read the complete skill folder and run its Node commands; otherwise a local operator performs the approved steps. Your model and provider are your choice. Automatic discovery and native behavior depend on the host; the release notes state exactly what was checked.',
              'Агент должен читать всю папку скилла и запускать его Node-команды; иначе согласованные шаги выполняет локальный оператор. Модель и провайдера выбираете вы. Автообнаружение и нативное поведение зависят от среды; точные проверки перечислены в описании релиза.',
            )}
          </p>
          <a href={release}>
            {t('Release scope and limits', 'Проверки и ограничения релиза')} ↗
          </a>
        </details>
      </div>
      <Installation {locale} />
    </div>
    <Features
      id="scenarios"
      {locale}
      tagline={t('2. Send one request', '2. Отправьте один запрос')}
      title={t(
        'Open the project in your agent',
        'Откройте проект в своём агенте',
      )}
      subtitle={t(
        'Copy the request for your task into the project session. Tibicen inspects the files and proposes the changes for your approval.',
        'Скопируйте запрос под вашу задачу в сессию проекта. Tibicen изучит файлы и предложит изменения для согласования.',
      )}
      items={scenarios}
    />
    <details class="start-help page-width first-session" id="skill-help">
      <summary>
        {t('The agent cannot find the skill?', 'Агент не находит скилл?')}
      </summary>
      <p>
        {t(
          'Ask it to read the exact SKILL.md path in the request, replacing ~ with your home directory if needed. Keep the whole skill folder available, including its references and scripts. Explicit reading is assisted loading; it does not prove automatic discovery.',
          'Попросите прочитать SKILL.md по пути из запроса; при необходимости замените ~ на домашний каталог. Нужна вся папка скилла, включая связанные инструкции и скрипты. Явное чтение — ручная загрузка; это не подтверждает автообнаружение.',
        )}
      </p>
      <a href={installationGuide}>
        {t('Installation and troubleshooting', 'Установка и решение проблем')} ↗
      </a>
    </details>
  </section>
  <InteractionExamples {locale} />
  <FAQs
    id="faq"
    tagline={t('Before your first run', 'Перед первым запуском')}
    title={t('What to know', 'Что нужно знать')}
    items={questions}
  />
  <section
    id="preset"
    class="preset-link page-width"
    aria-labelledby="preset-title"
  >
    <div>
      <p class="eyebrow">
        {t('For your next projects', 'Для следующих проектов')}
      </p>
      <h2 id="preset-title">
        {t('Reuse your preferences', 'Используйте свои предпочтения снова')}
      </h2>
      <p>
        {t(
          'Save preferences in an optional preset. Each project is still inspected afresh.',
          'Сохраните предпочтения в необязательный пресет. Каждый проект всё равно изучается заново.',
        )}
      </p>
    </div>
    <a class="button button-secondary" href={presetPath}>
      {t('Create a preset', 'Создать пресет')} <span aria-hidden="true">↗</span>
    </a>
  </section>
</SiteLayout>
<script src="../scripts/background.ts"></script>
