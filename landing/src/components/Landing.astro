---
import ProjectPreview from './ProjectPreview.astro';
import Installation from './Installation.astro';
import InteractionExamples from './InteractionExamples.astro';
import PresetForm from './PresetForm.astro';
import Features from './astrowind/Features.astro';
import Steps from './astrowind/Steps.astro';
import FAQs from './astrowind/FAQs.astro';
import { localize, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const repository = 'https://github.com/warbr1ng3r/tibicen';
const guide = `${repository}/blob/main/README.md`;
const installationGuide = `${repository}/blob/main/docs/INSTALLATION.md`;
const release = `${repository}/releases/tag/v1.4.0`;
const scenarios = [
  {
    label: 'tibicen-init',
    title: t('Set up for the first time', 'Настроить впервые'),
    description: t(
      'For an empty folder or an application without agent instructions. Describe your task and let Tibicen inspect the project.',
      'Для пустой папки или приложения без агентских инструкций. Опишите задачу — Tibicen изучит проект.',
    ),
    prompt: t(
      'Read ~/.agents/skills/tibicen-init/SKILL.md and follow its instructions. Set this project up for my coding agent.',
      'Прочитай ~/.agents/skills/tibicen-init/SKILL.md и следуй его инструкциям. Подготовь этот проект для моего агента.',
    ),
  },
  {
    label: 'tibicen-adopt',
    title: t('Improve an existing setup', 'Исправить и обновить'),
    description: t(
      'For existing instructions and tools. Review conflicts and outdated rules while preserving useful decisions.',
      'Для существующих инструкций и инструментов. Найдите конфликты и устаревшие правила, сохранив полезные решения.',
    ),
    prompt: t(
      'Read ~/.agents/skills/tibicen-adopt/SKILL.md and follow its instructions. Check the project instructions and fix what is outdated.',
      'Прочитай ~/.agents/skills/tibicen-adopt/SKILL.md и следуй его инструкциям. Проверь инструкции проекта и исправь устаревшее.',
    ),
  },
];
const steps = [
  {
    title: t('Inspect the project', 'Изучить проект'),
    description: t(
      'Read the structure, commands, existing instructions and your constraints. Select tools only when they solve a project need.',
      'Изучить структуру, команды, инструкции и ограничения. Подобрать инструменты, только если они решают задачу проекта.',
    ),
  },
  {
    title: t('Review the exact plan', 'Согласовать точный план'),
    description: t(
      'See the file changes, installations, commands and manual steps before approving them.',
      'Увидеть изменения файлов, установки, команды и ручные шаги до согласия.',
    ),
  },
  {
    title: t('Apply and check', 'Применить и проверить'),
    description: t(
      'Receive the approved changes and a final report showing what passed, failed or remains unverified.',
      'Получить согласованные изменения и итоговый отчёт: что проверено, где ошибки и что осталось непроверенным.',
    ),
  },
];
const questions = [
  {
    title: t(
      'Can I use another coding agent?',
      'Можно использовать другого агента?',
    ),
    description: t(
      'Use a host that can read project files and run the required Node commands. Explicitly open the installed SKILL.md; a catalog entry or automatic discovery is not required. Your host chooses the model and provider. Check Compatibility and limits for the narrower observations on the published release.',
      'Нужна среда, которая читает файлы проекта и запускает нужные Node-команды. Явно откройте установленный SKILL.md; запись в каталоге и автоматическое обнаружение не обязательны. Модель и провайдера выбирает ваша среда. Наблюдения для опубликованного релиза перечислены в разделе «Совместимость и ограничения».',
    ),
  },
  {
    title: t(
      'Do I need another account or API key?',
      'Нужен отдельный аккаунт или API-ключ?',
    ),
    description: t(
      'Tibicen runs inside your usual coding agent and needs no separate account or API key. Your agent and any selected external services keep their own authentication and costs.',
      'Tibicen работает внутри привычного агента, отдельный аккаунт или API-ключ не нужен. У агента и выбранных внешних сервисов остаются собственные авторизация и стоимость.',
    ),
  },
  {
    title: t(
      'What happens to existing project files?',
      'Что произойдёт с существующими файлами?',
    ),
    description: t(
      'Only approved agent infrastructure changes. Application source, data, existing package manifests and CI are preserved. Installations and project commands require approval. No commits or persistent Tibicen process are created.',
      'Меняется только согласованная агентская инфраструктура. Код приложения, данные, существующие package-файлы и CI сохраняются. Установка и проектные команды требуют согласия. Коммиты и постоянный процесс Tibicen не создаются.',
    ),
  },
  {
    title: t('Where does my data go?', 'Куда отправляются данные?'),
    description: t(
      'The optional preset is generated in your browser without sending answers. Project work follows your agent provider’s data rules. Component research uses external sources; keep secrets out of presets.',
      'Необязательный пресет создаётся в браузере без отправки ответов. Для работы с проектом действуют правила обработки данных вашего агента. Поиск компонентов использует внешние источники; секреты в пресет не добавляйте.',
    ),
  },
  {
    title: t(
      'How do updates and removal work?',
      'Как работают обновление и удаление?',
    ),
    description: t(
      'Updates are explicit; there is no background updater. Back up local skill edits before reinstalling a pinned release. Removing the skills does not undo approved project changes. The linked guide covers both operations.',
      'Обновления запускаются явно, фонового обновления нет. Перед переустановкой закреплённого релиза сохраните локальные правки скиллов. Удаление скиллов не отменяет согласованные изменения проекта. Обе операции описаны в инструкции по ссылке.',
    ),
  },
];
const geometry = [
  ['waves', t('Contour wave', 'Контурная волна')],
  ['cubes', t('Wireframe cubes', 'Каркасные кубы')],
  ['scaffold', t('Scaffolding', 'Строительные леса')],
  ['truss', t('Flat graph', 'Плоский граф')],
  ['lattice', t('Modular lattice', 'Модульная решётка')],
  ['clusters', t('Cluster network', 'Сеть центров')],
  ['dag', t('Branching graph', 'Граф с ветвлениями')],
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1c1c1c" />
    <meta
      name="description"
      content={t(
        'Set up project instructions and only the tools your coding agent needs. Review the exact plan before changes and receive a clear verification report.',
        'Настройте инструкции проекта и только нужные агенту инструменты. Сначала согласуйте точный план, затем получите изменения и понятный отчёт о проверках.',
      )}
    />
    <title>{t('Tibicen — set up your project for AI coding', 'Tibicen — подготовьте проект к работе с агентом')}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${basePath}/assets/favicon.svg`}
    />
    <script src="../scripts/app.ts"></script>
    <script src="../scripts/background.ts"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('Skip to content', 'К содержимому')}
    </a>
    <header class="header page-width">
      <a
        class="wordmark"
        href="#"
        aria-label={t('Tibicen — back to top', 'Tibicen — в начало')}
      >
        <img
          class="brand-mark"
          src={`${basePath}/assets/logo.svg`}
          width="36"
          height="36"
          alt=""
        />
        tibicen
      </a>
      <nav aria-label={t('Main navigation', 'Основная навигация')}>
        <a href="#start">{t('Get started', 'Начать')}</a>
        <a href="#result">{t('Example', 'Пример')}</a>
        <a href="#faq">{t('Questions', 'Вопросы')}</a>
      </nav>
      <div
        class="language-switch"
        role="group"
        aria-label={t('Page language', 'Язык страницы')}
      >
        <a
          href={`${basePath}/`}
          hreflang="en"
          lang="en"
          aria-label="English"
          aria-current={locale === 'en' ? 'page' : undefined}
        >
          EN
        </a>
        <a
          href={`${basePath}/ru/`}
          hreflang="ru"
          lang="ru"
          aria-label="Русский"
          aria-current={locale === 'ru' ? 'page' : undefined}
        >
          RU
        </a>
      </div>
      <a class="header-start" href="#start">
        {t('Install', 'Установить')} <span aria-hidden="true">↗</span>
      </a>
    </header>
    <nav
      class="geometry-preview page-width"
      aria-label={t('Compare background options', 'Сравнение вариантов фона')}
      hidden
    >
      <span>{t('Background options', 'Варианты фона')}</span>
      {geometry.map(([value, label]) => (
        <a href={`?preview=geometry&geometry=${value}`} data-geometry={value}>
          {label}
        </a>
      ))}
    </nav>
    <main id="main">
      <div class="hero-surface" data-geometry="truss">
        <section class="hero page-width" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow">
              <span class="eyebrow-line" aria-hidden="true"></span>
              {t(
                'Project setup for coding agents',
                'Настройка проекта для агентов',
              )}
            </p>
            <h1 id="hero-title">
              {t('Set up your project for ', 'Подготовьте проект к работе ')}
              <span>{t('AI coding.', 'с агентом.')}</span>
            </h1>
            <p class="hero-description">
              {t(
                'Two skills inside your usual coding agent: set up a project or fix existing instructions and tools. Review every change first.',
                'Два скилла внутри привычного агента: настройте проект или исправьте существующие инструкции и инструменты. Сначала согласуйте изменения.',
              )}
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="#start">
                {t('Install Tibicen', 'Установить Tibicen')}{' '}
                <span aria-hidden="true">↗</span>
              </a>
              <a class="text-link" href="#result">
                {t('See a walkthrough', 'Посмотреть пример')}{' '}
                <span aria-hidden="true">↓</span>
              </a>
            </div>
            <p class="hero-note">
              <span class="status-dot" aria-hidden="true"></span>
              Tibicen · 1.4.0 · MIT
            </p>
          </div>
          <ProjectPreview {locale} />
        </section>
      </div>
      <section class="start-section" id="start" aria-labelledby="start-title">
        <div class="page-width start-grid start-install">
          <div class="start-copy">
            <p class="eyebrow">
              <span class="eyebrow-line" aria-hidden="true"></span>
              {t('Two skills, one install', 'Два скилла, одна установка')}
            </p>
            <h2 id="start-title">{t('Get started', 'Начните работу')}</h2>
            <p>
              {t(
                'Your agent needs file access and Node ≥22.20; the installer needs Git. No preset required.',
                'Нужны доступ к файлам, Node ≥22.20 и Git для установщика. Пресет необязателен.',
              )}
            </p>
            <p class="support-note">
              {t(
                'Automatic loading is experimental. Without file/Node tools, use a local operator. On Windows, run project commands manually.',
                'Автозагрузка экспериментальна. Без файлов/Node нужен локальный оператор. На Windows запускайте команды проекта вручную.',
              )}
            </p>
            <details class="start-help" id="compatibility">
              <summary>
                {t('Compatibility and limits', 'Совместимость и ограничения')}
              </summary>
              <p>
                {t(
                  'Mechanical installation checks cover Codex, Claude Code and Cursor, including the installed file contents. This does not prove that every agent will discover and use the skills automatically. Project build/test/lint checks currently use the web profile. Bounded agent exercises do not establish support for every environment; see the release notes for exact versions and observations.',
                  'Механические проверки установки охватывают Codex, Claude Code и Cursor, включая содержимое установленных файлов. Это не доказывает, что каждый агент автоматически найдёт и применит скиллы. Проектные build/test/lint-проверки пока используют web-профиль. Ограниченные упражнения с агентами не подтверждают все среды; точные версии и наблюдения указаны в описании релиза.',
                )}
              </p>
              <a href={release}>
                {t('Full release scope', 'Область проверки релиза')} ↗
              </a>
            </details>
          </div>
          <Installation {locale} />
        </div>
        <div class="page-width first-session">
          <p class="start-step">
            {t(
              '3. Open the skill in your project session',
              '3. Откройте скилл в сессии проекта',
            )}
          </p>
          <p>
            {t(
              'Open your agent in the project folder and send one request below. Replace ~ with your home directory if needed, or use your manual-install path. Keep the complete skill folder available for its resources.',
              'Откройте агента в папке проекта и отправьте один запрос ниже. При необходимости замените ~ на домашнюю папку или укажите путь ручной установки. Сохраните доступ ко всей папке скилла с ресурсами.',
            )}
          </p>
          <details class="start-help" id="skill-help">
            <summary>
              {t('The agent cannot find the skill?', 'Агент не находит скилл?')}
            </summary>
            <ol>
              <li>
                {t(
                  'Ask the agent to read the exact SKILL.md path shown in the request. If necessary, provide its absolute path or use the host’s documented file-attachment step.',
                  'Попросите агента прочитать SKILL.md по пути из запроса. При необходимости укажите абсолютный путь или прикрепите файл способом из документации среды.',
                )}
              </li>
              <li>
                {t(
                  'The host must also read the skill’s referenced files and run its Node CLI. Without those tools, use a local operator for the approved commands; supplied text alone only supports guidance.',
                  'Среда должна читать связанные файлы скилла и запускать его Node CLI. Без этих средств согласованные команды выполняет локальный оператор; переданный текст даёт только рекомендации.',
                )}
              </li>
              <li>
                {t(
                  'Explicit reading is assisted loading. Automatic discovery and use remain unverified for your host. After setup, explicitly read the approved project AGENTS.md in each session when the host does not discover it.',
                  'Явное чтение — ручная загрузка. Автоматическое обнаружение и использование в вашей среде остаются непроверенными. После настройки явно читайте согласованный AGENTS.md проекта в каждой сессии, если среда не находит его сама.',
                )}
              </li>
            </ol>
            <a href={installationGuide}>
              {t(
                'Installation and explicit invocation',
                'Установка и явный вызов',
              )}{' '}
              ↗
            </a>
          </details>
        </div>
        <Features
          id="scenarios"
          {locale}
          tagline={t(
            '4. Send your first request',
            '4. Отправьте первый запрос',
          )}
          title={t(
            'Open your project. Pick your task.',
            'Откройте проект. Выберите задачу.',
          )}
          items={scenarios}
        />
      </section>
      <Steps
        id="workflow"
        tagline={t('How it works', 'Как это работает')}
        title={t('A plan you control', 'План под вашим контролем')}
        items={steps}
      />
      <InteractionExamples {locale} />
      <FAQs
        id="faq"
        tagline={t('Before your first run', 'Перед первым запуском')}
        title={t('What to know', 'Что нужно знать')}
        items={questions}
      />
      <section
        class="preset-section section-space page-width"
        id="preset"
        aria-labelledby="preset-title"
      >
        <div class="preset-intro">
          <p class="eyebrow">{t('Optional', 'Необязательно')}</p>
          <h2 id="preset-title">
            {t('Save your preferences', 'Сохраните предпочтения')}
          </h2>
          <p>
            {t(
              'Reuse your preferred workflow and constraints in similar projects. Pass preset.yaml to your agent; it will inspect each project again.',
              'Сохраните привычный процесс и ограничения для похожих проектов. Передайте preset.yaml агенту — каждый проект он изучит заново.',
            )}
          </p>
          <p class="privacy-note">
            {t(
              'Generated in your browser. No answers are sent.',
              'Создаётся в вашем браузере. Ответы никуда не отправляются.',
            )}
          </p>
        </div>
        <PresetForm {locale} />
      </section>
    </main>
    <footer class="footer page-width">
      <a
        class="wordmark"
        href="#"
        aria-label={t('Tibicen — back to top', 'Tibicen — в начало')}
      >
        <img
          class="brand-mark"
          src={`${basePath}/assets/logo.svg`}
          width="28"
          height="28"
          alt=""
        />
        tibicen
      </a>
      <div class="project-links">
        <a href={repository}>GitHub</a>
        <a href={guide}>{t('Documentation', 'Документация')}</a>
        <a href={release}>{t('Release notes', 'Описание релиза')}</a>
        <a href={`${basePath}/maintenance/index.json`}>
          {t('Advisories and checksums', 'Предупреждения и суммы')}
        </a>
        <a href={`${guide}#update-or-remove-an-installation`}>
          {t('Update or remove', 'Обновить или удалить')}
        </a>
        <a href={`${repository}/blob/main/LICENSE`}>MIT</a>
      </div>
      <span>
        {t('Sections adapted from', 'Секции на основе')} AstroWind ·{' '}
        <a href={`${basePath}/licenses/astrowind.txt`}>AstroWind MIT</a> ·{' '}
        <a href={`${basePath}/licenses/starwind.txt`}>Starwind MIT</a>
      </span>
    </footer>
    <p
      id="copy-status"
      class="copy-status"
      role="status"
      aria-live="polite"
    ></p>
    <noscript>
      <p class="noscript-note">
        {t(
          'Installation commands, prompts and language links work without JavaScript. Enable JavaScript to copy text or download a preset.',
          'Команды установки, запросы и ссылки языка работают без JavaScript. Для копирования и скачивания пресета включите JavaScript.',
        )}
      </p>
    </noscript>
  </body>
</html>
