---
import { managers, installationCommand } from '../scripts/install';
import Select from './ui/Select.astro';
import { localize, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
---

<div class="installation">
  <p class="start-step">
    {t('1. Choose a command runner', '1. Выберите способ запуска')}
  </p>
  <div class="installation-head">
    <span>Tibicen 1.2.0</span>
    <button
      class="copy-button"
      type="button"
      data-copy-target="install-command"
      aria-label={t(
        'Copy installation command',
        'Скопировать команду установки',
      )}
    >
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect
          x="7"
          y="7"
          width="9"
          height="10"
          rx="1.5"
          stroke="currentColor"
        />
        <path d="M12 7V3H3v10h4" stroke="currentColor" />
      </svg>
      <span data-copy-label>{t('Copy', 'Копировать')}</span>
    </button>
  </div>
  <fieldset
    id="install-controls"
    class="install-options"
    aria-label={t('Installation options', 'Настройки установки')}
    disabled
  >
    <div>
      <label for="install-manager">
        {t('Command runner', 'Чем запустить команду')}
      </label>
      <Select
        id="install-manager"
        label={t('Command runner', 'Чем запустить команду')}
        value="npm"
        options={Object.keys(managers).map((value) => ({
          value,
          label: value === 'yarn' ? 'Yarn 2+' : value,
        }))}
      />
    </div>
  </fieldset>
  <p class="start-step install-run">
    {t('2. Run this in your terminal', '2. Выполните в терминале')}
  </p>
  <pre><code id="install-command">{installationCommand('npm')}</code></pre>
  <p>
    {t('Installs both complete skills in', 'Установит оба скилла целиком в')}{' '}
    <code>~/.agents/skills/</code>.
    {t(
      ' Open the entry file explicitly in your agent. Back up local skill edits before reinstalling.',
      ' Явно откройте файл скилла в своём агенте. Перед переустановкой сохраните локальные правки скиллов.',
    )}
  </p>
  <p>
    <a href="https://github.com/warbr1ng3r/tibicen/blob/main/docs/INSTALLATION.md#manual-archive-installation">
      {t(
        'Manual archive installation and checksums',
        'Установка из архива и контрольные суммы',
      )}{' '}
      ↗
    </a>
  </p>
  <noscript>
    <p>
      {t(
        'Without JavaScript, the command uses npm and the universal folder. For pnpm use',
        'Без JavaScript показана команда для npm и общей папки. Для pnpm используйте',
      )}{' '}
      <code>pnpm dlx</code>
      {t(', for Yarn 2+ use', ', для Yarn 2+ —')} <code>yarn dlx</code>{' '}
      {t('instead of', 'вместо')} <code>npx</code>.{t(' Keep', ' Сохраните')}{' '}
      <code>--agent universal</code>.
    </p>
  </noscript>
</div>
<script>
  import { mountInstallation } from '../scripts/install';
  mountInstallation();
</script>
