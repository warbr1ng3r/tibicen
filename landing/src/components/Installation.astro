---
import { installationCommand, type Manager } from '../scripts/install';
import { localize, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
const alternatives: { manager: Manager; label: string }[] = [
  { manager: 'pnpm', label: 'pnpm' },
  { manager: 'yarn', label: 'Yarn 2+' },
];
---

<div class="installation">
  <p class="start-step">
    {t('1. Run this in your terminal', '1. Выполните в терминале')}
  </p>
  <div class="installation-head">
    <span>Tibicen 1.5.4</span>
    <button
      class="copy-button"
      type="button"
      data-copy-target="install-command"
      aria-label={t(
        'Copy installation command',
        'Скопировать команду установки',
      )}
    >
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect
          x="7"
          y="7"
          width="9"
          height="10"
          rx="1.5"
          stroke="currentColor"
        />
        <path d="M12 7V3H3v10h4" stroke="currentColor" />
      </svg>
      <span data-copy-label>{t('Copy', 'Копировать')}</span>
    </button>
  </div>
  <pre><code id="install-command">{installationCommand('npm')}</code></pre>
  <p>
    {t('Installs both skills in', 'Установит оба скилла в')}{' '}
    <code>~/.agents/skills/</code>.
    {t(
      ' Back up local skill edits before reinstalling.',
      ' Перед переустановкой сохраните локальные правки скиллов.',
    )}
  </p>
  <details class="installation-alternatives">
    <summary>
      {t('Other installation methods', 'Другие способы установки')}
    </summary>
    {alternatives.map(({ manager, label }) => (
      <div class="installation-alternative">
        <div class="installation-head">
          <span>{label}</span>
          <button
            class="copy-button"
            type="button"
            data-copy-target={`install-command-${manager}`}
            aria-label={t(
              `Copy ${label} installation command`,
              `Скопировать команду установки для ${label}`,
            )}
          >
            <span data-copy-label>{t('Copy', 'Копировать')}</span>
          </button>
        </div>
        <pre><code id={`install-command-${manager}`}>{installationCommand(manager)}</code></pre>
      </div>
    ))}
    <a href="https://github.com/warbr1ng3r/tibicen/blob/main/docs/INSTALLATION.md#manual-archive-installation">
      {t(
        'Manual archive installation and checksums',
        'Установка из архива и контрольные суммы',
      )}{' '}
      ↗
    </a>
  </details>
</div>

<style>
  .installation-alternatives {
    margin-top: 18px;
    border-top: 1px solid var(--line);
    padding-top: 14px;
    font-size: 12px;
    line-height: 1.85;
  }
  .installation-alternatives > summary {
    cursor: pointer;
    color: var(--ink);
    min-height: 44px;
    padding-block: 10px;
  }
  .installation-alternative {
    margin-top: 18px;
  }
</style>
