---
import { agents, managers, installationCommand } from '../scripts/install';
import Select from './ui/Select.astro';
import { localize, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
---

<div class="installation">
  <p class="start-step">
    {t('1. Choose your coding agent', '1. Выберите своего агента')}
  </p>
  <div class="installation-head">
    <span>Tibicen 1.1.0</span>
    <button
      class="copy-button"
      type="button"
      data-copy-target="install-command"
      aria-label={t(
        'Copy installation command',
        'Скопировать команду установки',
      )}
    >
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect
          x="7"
          y="7"
          width="9"
          height="10"
          rx="1.5"
          stroke="currentColor"
        />
        <path d="M12 7V3H3v10h4" stroke="currentColor" />
      </svg>
      <span data-copy-label>{t('Copy', 'Копировать')}</span>
    </button>
  </div>
  <fieldset
    id="install-controls"
    class="install-options"
    aria-label={t('Installation options', 'Настройки установки')}
    disabled
  >
    <div>
      <label for="install-agent">{t('Your coding agent', 'Ваш агент')}</label>
      <Select
        id="install-agent"
        label={t('Your coding agent', 'Ваш агент')}
        value="codex"
        options={Object.entries(agents).map(([value, label]) => ({
          value,
          label,
        }))}
      />
    </div>
    <div>
      <label for="install-manager">
        {t('Command runner', 'Чем запустить команду')}
      </label>
      <Select
        id="install-manager"
        label={t('Command runner', 'Чем запустить команду')}
        value="npm"
        options={Object.keys(managers).map((value) => ({
          value,
          label: value === 'yarn' ? 'Yarn 2+' : value,
        }))}
      />
    </div>
  </fieldset>
  <p class="start-step install-run">
    {t('2. Run this in your terminal', '2. Выполните в терминале')}
  </p>
  <pre><code id="install-command">{installationCommand('npm', 'codex')}</code></pre>
  <p>
    {t(
      'Installs both skills in your user account for the selected agent, across projects. It does not change your project’s packages.',
      'Установит оба скилла для выбранного агента в вашей учётной записи, для разных проектов. Пакеты проекта не меняются.',
    )}
  </p>
  <noscript>
    <p>
      {t(
        'Without JavaScript, the command uses npm and Codex. For pnpm use',
        'Без JavaScript показана команда для npm и Codex. Для pnpm используйте',
      )}{' '}
      <code>pnpm dlx</code>
      {t(', for Yarn 2+ use', ', для Yarn 2+ —')} <code>yarn dlx</code>{' '}
      {t('instead of', 'вместо')} <code>npx</code>. {t('The', 'Значение')}{' '}
      <code>--agent</code>
      {t(' value is', ':')} <code>codex</code>, <code>claude-code</code>{' '}
      {t('or', 'или')} <code>cursor</code>.
    </p>
  </noscript>
</div>
<script>
  import { mountInstallation } from '../scripts/install';
  mountInstallation();
</script>
