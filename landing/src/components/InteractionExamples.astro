---
import { localize, type Locale } from '../i18n';
import WorkflowSummary from './WorkflowSummary.astro';
import SetupScope from './SetupScope.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
const examples = [
  {
    id: 'init',
    skill: 'tibicen-init',
    title: t('First-time setup', 'Настроить с нуля'),
    before: t(
      'The task-board app uses Node and lets you add tasks and mark them done. Code and tests already exist; AGENTS.md does not.',
      'В приложении task-board на Node можно добавлять задачи и отмечать их выполненными. Код и тесты уже есть, AGENTS.md пока нет.',
    ),
    files: 'task-board/\n  src/\n  tests/\n  package.json',
    initial: 'package.json\n"scripts": { "test": "node --test" }',
    request: t(
      'Use tibicen-init. Set up this repo for my agent.',
      'Используй tibicen-init. Настрой проект для работы с агентом.',
    ),
    inspection: t(
      'Reads package.json, src/ and tests/. Finds the test command and no existing agent instructions.',
      'Читает package.json, src/ и tests/. Находит команду тестов и видит, что агентских инструкций ещё нет.',
    ),
    clarification: t(
      'No extra questions are needed: the project structure and test command are already known.',
      'Дополнительные вопросы не нужны: структура проекта и команда запуска тестов уже известны.',
    ),
    proposal: t(
      'Create AGENTS.md with the instructions below and save setup details in .tibicen/. Application files stay unchanged. No tools need installing and no project commands need running.',
      'Создать AGENTS.md с инструкциями ниже и сохранить сведения о настройке в .tibicen/. Файлы приложения останутся без изменений. Устанавливать инструменты и запускать команды проекта не потребуется.',
    ),
    diff: '+ AGENTS.md\n+ # Project instructions\n+ - Application code: src/. Tests: tests/.\n+ - Test command: `node --test`.',
    result: t(
      'Adds the approved AGENTS.md and .tibicen/manifest.yml; shows the results of file content and structure checks. src/, tests/ and package.json stay unchanged.',
      'Добавляет согласованный AGENTS.md и .tibicen/manifest.yml; показывает результаты проверки содержимого и структуры файлов. src/, tests/ и package.json не меняются.',
    ),
  },
  {
    id: 'adopt',
    skill: 'tibicen-adopt',
    title: t('Review existing setup', 'Навести порядок'),
    before: t(
      'The notes-api service uses Node to store notes. Code and tests already exist. AGENTS.md still has an outdated test command and a useful rule about adding dependencies.',
      'Сервис notes-api на Node хранит заметки. Код и тесты уже есть. В AGENTS.md остались устаревшая команда запуска тестов и полезное правило о добавлении зависимостей.',
    ),
    files: 'notes-api/\n  src/\n  tests/\n  package.json\n  AGENTS.md',
    initial: t(
      'package.json\n"scripts": { "test": "node --test" }\n\nAGENTS.md\nTest command: `npm run test:old`.\nAsk before adding dependencies.',
      'package.json\n"scripts": { "test": "node --test" }\n\nAGENTS.md\nКоманда тестов: `npm run test:old`.\nСпрашивай перед добавлением зависимостей.',
    ),
    request: t(
      'Use tibicen-adopt. The agent keeps using the wrong test command. Sort it out.',
      'Используй tibicen-adopt. Агент всё время запускает не ту команду тестов. Разберись.',
    ),
    inspection: t(
      'Compares AGENTS.md with package.json. test:old is missing; npm test runs node --test. Keeps the dependency rule.',
      'Сравнивает AGENTS.md и package.json. test:old отсутствует; npm test запускает node --test. Сохраняет правило о зависимостях.',
    ),
    clarification: t(
      'No extra questions are needed: package.json gives the correct command, and the dependency rule can stay as it is.',
      'Дополнительные вопросы не нужны: правильная команда указана в package.json, а правило о зависимостях менять незачем.',
    ),
    proposal: t(
      'Correct the test command in AGENTS.md and save the change details in .tibicen/. The dependency rule and application files stay unchanged. No tools need installing and no project commands need running.',
      'Исправить команду запуска тестов в AGENTS.md и сохранить сведения об изменении в .tibicen/. Правило о зависимостях и файлы приложения останутся без изменений. Установка инструментов и запуск команд проекта не потребуются.',
    ),
    diff: t(
      'AGENTS.md\n- Test command: `npm run test:old`.\n+ Test command: `npm test`.\n  Ask before adding dependencies.',
      'AGENTS.md\n- Команда тестов: `npm run test:old`.\n+ Команда тестов: `npm test`.\n  Спрашивай перед добавлением зависимостей.',
    ),
    result: t(
      'Corrects that line and records it in .tibicen/manifest.yml; shows the results of file content and structure checks. The dependency rule, src/, tests/ and package.json stay unchanged.',
      'Исправляет строку и записывает изменение в .tibicen/manifest.yml; показывает результаты проверки содержимого и структуры файлов. Правило о зависимостях, src/, tests/ и package.json не меняются.',
    ),
  },
];
---

<section
  id="result"
  class="result-section section-space page-width"
  aria-labelledby="result-title"
>
  <WorkflowSummary {locale} />
  <details class="detailed-examples" id="complete-examples">
    <summary>
      {t(
        'Setup and instruction update examples',
        'Примеры настройки и обновления инструкций',
      )}
      <span aria-hidden="true">+</span>
    </summary>
    <div class="detailed-content">
      <p class="eyebrow">{t('Illustrative examples', 'Учебные примеры')}</p>
      <h3 id="detailed-result-title">
        {t(
          'From request to finished changes',
          'От запроса до готовых изменений',
        )}
      </h3>
      <p class="example-intro">
        {t(
          'Examples using two fictional projects. Your project may need a different plan and have different check results.',
          'Примеры на двух вымышленных проектах. В вашем проекте план и результаты проверок могут отличаться.',
        )}
      </p>
      <fieldset class="example-switcher">
        <legend>{t('See how it works', 'Как это работает')}</legend>
        {examples.map((example) => (
          <>
            <input
              class="example-choice"
              type="radio"
              name="walkthrough-case"
              id={`example-choice-${example.id}`}
              value={example.id}
              checked={example.id === 'init'}
              aria-controls={`walkthrough-${example.id}`}
            />
            <label for={`example-choice-${example.id}`}>{example.title}</label>
          </>
        ))}
        <div class="result-grid">
          {examples.map((example) => (
            <article
              class="result-card walkthrough"
              id={`walkthrough-${example.id}`}
              aria-labelledby={`walkthrough-${example.id}-title`}
            >
              <p class="skill-label">{example.skill}</p>
              <h3 id={`walkthrough-${example.id}-title`}>{example.title}</h3>
              <ol class="walkthrough-steps">
                <li data-step="before">
                  <h4>{t('Starting project', 'Что было в проекте')}</h4>
                  <p>{example.before}</p>
                  <details>
                    <summary>
                      {t(
                        'Files and existing instructions',
                        'Файлы и исходные инструкции',
                      )}
                    </summary>
                    <pre><code>{example.files}</code></pre>
                    <pre><code>{example.initial}</code></pre>
                  </details>
                </li>
                <li data-step="request">
                  <h4>{t('You ask', 'Вы пишете')}</h4>
                  <blockquote>{example.request}</blockquote>
                </li>
                <li data-step="inspect">
                  <h4>{t('The agent inspects', 'Агент изучает')}</h4>
                  <p>{example.inspection}</p>
                  <p class="clarification">{example.clarification}</p>
                </li>
                <li data-step="proposal">
                  <h4>{t('The agent proposes', 'Агент предлагает')}</h4>
                  <p>{example.proposal}</p>
                  <details>
                    <summary>
                      {t('View changes', 'Посмотреть изменения')}
                    </summary>
                    <pre class="proposal-diff"><code>{example.diff}</code></pre>
                  </details>
                </li>
                <li data-step="approval">
                  <h4>{t('You approve', 'Вы соглашаетесь')}</h4>
                  <blockquote>
                    {t('Yes, apply this plan.', 'Да, примени этот план.')}
                  </blockquote>
                </li>
                <li data-step="result">
                  <h4>
                    {t(
                      'The agent applies and checks the changes',
                      'Агент вносит изменения и проверяет результат',
                    )}
                  </h4>
                  <p>{example.result}</p>
                  <p class="example-unverified">
                    {t(
                      'These examples do not show project tests or the next agent session. In a real run, Tibicen lists the checks performed and their limits.',
                      'Эти примеры не показывают запуск тестов или работу агента в следующем чате. При реальном запуске Tibicen перечислит выполненные проверки и их ограничения.',
                    )}
                  </p>
                </li>
              </ol>
            </article>
          ))}
        </div>
      </fieldset>
    </div>
  </details>
</section>
<SetupScope {locale} />

<style>
  .example-switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .example-switcher legend {
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 13px;
  }

  .example-choice {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .example-switcher > label {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--muted);
    cursor: pointer;
    font-size: 14px;
  }

  .example-choice:checked + label {
    border-color: var(--accent);
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
  }

  .example-choice:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .result-grid {
    display: block;
    flex-basis: 100%;
    min-width: 0;
  }

  .walkthrough {
    display: none;
  }

  #example-choice-init:checked ~ .result-grid #walkthrough-init,
  #example-choice-adopt:checked ~ .result-grid #walkthrough-adopt {
    display: block;
  }

  .walkthrough-steps > li + li {
    margin-top: 18px;
  }

  .walkthrough details {
    margin-top: 10px;
  }

  .walkthrough summary {
    display: list-item;
    min-height: 44px;
    padding-block: 10px;
    color: var(--ink);
    cursor: pointer;
  }
</style>
