---
import { localize, type Locale } from '../i18n';
import SetupIcon from './SetupIcon.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
const modules = [
  {
    icon: 'memory' as const,
    title: t('Memory', 'Память'),
    note: t('Your decisions', 'Ваши решения'),
  },
  {
    icon: 'skills' as const,
    title: t('Skills', 'Скиллы'),
    note: t('For recurring tasks', 'Для повторяющихся задач'),
  },
  {
    icon: 'plug' as const,
    title: t('Tools', 'Инструменты'),
    note: t('Useful connections', 'Нужные подключения'),
  },
];
const benefits = [
  t(
    'Application code and data stay unchanged',
    'Код и данные остаются без изменений',
  ),
  t(
    'Useful existing rules are preserved',
    'Полезные существующие правила сохраняются',
  ),
  t(
    'Tibicen does not run in the background after setup',
    'После настройки Tibicen не работает в фоне',
  ),
  t(
    'The report shows what was checked and any remaining limits',
    'В отчёте видно, что проверено и какие ограничения остались',
  ),
];
---

<section
  class="setup-composition setup-scope page-width"
  id="setup-scope"
  aria-labelledby="scope-title"
>
  <div class="scope-diagram" aria-label={t('Agent setup', 'Настройка агента')}>
    <div class="scope-layer">
      <div class="scope-content">
        <div class="scope-stage">
          <span>{t('Agent setup', 'Настройка агента')}</span>
          <small>{t('after your approval', 'после вашего согласия')}</small>
        </div>
        <div class="instruction-panel">
          <SetupIcon name="file" />
          <div>
            <strong>{t('Clear instructions', 'Понятные инструкции')}</strong>
            <p>{t('For the agent you use', 'Для вашего агента')}</p>
          </div>
          <SetupIcon name="check" />
        </div>
        <p class="module-label">
          {t('Added when needed', 'Добавляется при необходимости')}
        </p>
        <div class="module-grid">
          {modules.map((module) => (
            <div>
              <SetupIcon name={module.icon} />
              <strong>{module.title}</strong>
              <small>{module.note}</small>
            </div>
          ))}
        </div>
        <div class="project-layer">
          <SetupIcon name="folder" />
          <div>
            <strong>
              {t('Project code and data', 'Код и данные проекта')}
            </strong>
            <p>src/ · tests/ · docs/ · data/</p>
          </div>
          <span>{t('unchanged', 'без изменений')}</span>
        </div>
      </div>
    </div>
  </div>
  <div class="composition-copy">
    <p class="eyebrow">
      {t('What stays in your project', 'Что останется в проекте')}
    </p>
    <h2 id="scope-title">
      {t(
        'Instructions and tools for your project',
        'Инструкции и инструменты для вашего проекта',
      )}
    </h2>
    <p>
      {t(
        'Instructions reflect the project tasks and your rules. Memory, skills and connections are added when needed.',
        'Инструкции учитывают задачи проекта и ваши правила. Память, скиллы и подключения добавляются при необходимости.',
      )}
    </p>
    <ul class="scope-benefits">
      {benefits.map((benefit) => (
        <li>
          <SetupIcon name="check" />
          <span>{benefit}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
