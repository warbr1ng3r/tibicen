---
import Field from './ui/Field.astro';
import Select from './ui/Select.astro';
import { localize, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);

const languages = [
  { value: '', label: t('Detect in project', 'Определить в проекте') },
  ...['TypeScript', 'JavaScript', 'Python', 'Go', 'Rust', 'Java'].map(
    (label) => ({ value: label.toLowerCase(), label }),
  ),
  { value: 'csharp', label: 'C#' },
];
const kinds = [
  { value: '', label: t('Various projects', 'Разные проекты') },
  { value: 'application', label: t('Applications', 'Приложения') },
  { value: 'service', label: t('Services', 'Сервисы') },
  { value: 'library', label: t('Libraries', 'Библиотеки') },
  { value: 'experiment', label: t('Experiments', 'Эксперименты') },
];
---

<details class="preset-details">
  <summary>
    <span>
      <strong>{t('Build your preset', 'Собрать свой пресет')}</strong>
      <small>
        {t(
          'Preferences for your next projects',
          'Параметры работы для следующих проектов',
        )}
      </small>
    </span>
    <span class="details-toggle" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M12 5v14M5 12h14"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
    </span>
  </summary>
  <form id="preset-form" class="preset-form" novalidate>
    <fieldset
      id="preset-controls"
      class="preset-controls"
      aria-label={t('Preset options', 'Параметры пресета')}
      disabled
    >
      <Field
        id="name"
        label={t('Preset name', 'Имя пресета')}
        hint={t(
          'Lowercase Latin letters, numbers and hyphens. For example, hackathon.',
          'Латинские буквы, цифры и дефисы. Например, hackathon.',
        )}
      >
        <input
          id="name"
          name="name"
          value="my-setup"
          maxlength="64"
          pattern="[a-z0-9][a-z0-9\-]{0,63}"
          aria-describedby="name-hint name-error"
          required
        />
      </Field>
      <fieldset data-field="process">
        <legend>
          {t('How much process do you need?', 'Сколько процесса вам нужно?')}
        </legend>
        <div class="choice-grid">
          <label class="choice">
            <input
              type="radio"
              name="process"
              value="minimal"
              aria-describedby="process-error"
            />
            <span>
              <strong>{t('Minimal', 'Минимум')}</strong>
              <small>{t('Only essential steps', 'Без лишних шагов')}</small>
            </span>
          </label>
          <label class="choice">
            <input
              type="radio"
              name="process"
              value="balanced"
              aria-describedby="process-error"
              checked
            />
            <span>
              <strong>{t('Balanced', 'Баланс')}</strong>
              <small>{t('A practical structure', 'Разумная структура')}</small>
            </span>
          </label>
          <label class="choice">
            <input
              type="radio"
              name="process"
              value="structured"
              aria-describedby="process-error"
            />
            <span>
              <strong>{t('Structured', 'Структурно')}</strong>
              <small>{t('More stages', 'Больше этапов')}</small>
            </span>
          </label>
        </div>
        <p
          id="process-error"
          class="field-error"
          data-field-error
          role="alert"
          hidden
        ></p>
      </fieldset>
      <Field id="style" label={t('Agent responses', 'Ответы агента')}>
        <Select
          id="style"
          name="style"
          label={t('Agent responses', 'Ответы агента')}
          value="concise"
          describedBy="style-error"
          options={[
            { value: 'concise', label: t('Concise', 'Коротко и по делу') },
            {
              value: 'detailed',
              label: t('Detailed', 'С подробным объяснением'),
            },
          ]}
        />
      </Field>
      <details class="advanced">
        <summary>
          {t(
            'Optional project hints and protected paths',
            'Необязательные подсказки и защищённые пути',
          )}
        </summary>
        <div class="field-row">
          <Field
            id="language"
            label={t('Programming language', 'Язык программирования')}
          >
            <Select
              id="language"
              name="language"
              label={t('Programming language', 'Язык программирования')}
              value=""
              options={languages}
              describedBy="language-error"
            />
          </Field>
          <Field id="kind" label={t('Project type', 'Тип проектов')}>
            <Select
              id="kind"
              name="kind"
              label={t('Project type', 'Тип проектов')}
              value=""
              options={kinds}
              describedBy="kind-error"
            />
          </Field>
        </div>
        <fieldset data-field="agents">
          <legend>{t('Agent hints', 'Какими агентами пользуетесь?')}</legend>
          <div class="agent-choices">
            <label>
              <input
                type="checkbox"
                name="agents"
                value="claude-code"
                aria-describedby="agents-hint agents-error"
              />{' '}
              Claude Code
            </label>
            <label>
              <input
                type="checkbox"
                name="agents"
                value="codex"
                aria-describedby="agents-hint agents-error"
              />{' '}
              Codex
            </label>
            <label>
              <input
                type="checkbox"
                name="agents"
                value="cursor"
                aria-describedby="agents-hint agents-error"
              />{' '}
              Cursor
            </label>
          </div>
          <small id="agents-hint">
            {t(
              'Leave empty to let the agent check your environment.',
              'Можно оставить пустым — агент уточнит окружение.',
            )}
          </small>
          <p
            id="agents-error"
            class="field-error"
            data-field-error
            role="alert"
            hidden
          ></p>
        </fieldset>
        <Field
          id="forbidden-paths"
          name="forbiddenPaths"
          label={t(
            'Protected paths: one relative path per line',
            'По одному относительному пути на строку',
          )}
          hint={t(
            'Path names only, without file contents or secrets.',
            'Только названия путей, без содержимого файлов и секретов.',
          )}
        >
          <textarea
            id="forbidden-paths"
            name="forbiddenPaths"
            rows="3"
            placeholder="data/raw&#10;private/"
            aria-describedby="forbidden-paths-hint forbidden-paths-error"
          ></textarea>
        </Field>
      </details>
      <p id="form-error" class="form-error" role="alert" hidden></p>
      <button
        id="download-preset"
        class="button button-primary download-button"
        type="submit"
        disabled
      >
        {t('Download preset.yaml', 'Скачать preset.yaml')}{' '}
        <span aria-hidden="true">↓</span>
      </button>
    </fieldset>
    <p class="form-footnote">
      {t(
        'The preset saves preferences. Review and approve a separate change plan in each project.',
        'Пресет сохраняет предпочтения. План изменений согласуется отдельно в каждом проекте.',
      )}
    </p>
    <p
      id="download-status"
      class="download-status"
      role="status"
      aria-live="polite"
    ></p>
  </form>
</details>
