---
import Field from './ui/Field.astro';
import Select from './ui/Select.astro';
import { localize, type Locale } from '../i18n';
import { HARNESS_PROFILES } from '../../../scripts/agents/profiles';

interface Props {
  locale?: Locale;
  expanded?: boolean;
}
const { locale = 'en', expanded = false } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);

const languages = [
  {
    value: '',
    label: t('Detect from project files', 'Определить по файлам проекта'),
  },
  ...['TypeScript', 'JavaScript', 'Python', 'Go', 'Rust', 'Java'].map(
    (label) => ({ value: label.toLowerCase(), label }),
  ),
  { value: 'csharp', label: 'C#' },
];
const kinds = [
  { value: '', label: t('Various projects', 'Разные проекты') },
  { value: 'application', label: t('Applications', 'Приложения') },
  { value: 'service', label: t('Services', 'Сервисы') },
  { value: 'library', label: t('Libraries', 'Библиотеки') },
  { value: 'experiment', label: t('Experiments', 'Эксперименты') },
];
---

<details class="preset-details" open={expanded}>
  <summary>
    <span>
      <strong>{t('Preset settings', 'Настройки пресета')}</strong>
      <small>
        {t(
          'How your agent should work in your projects',
          'Как агенту работать в ваших проектах',
        )}
      </small>
    </span>
    <span class="details-toggle" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M12 5v14M5 12h14"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
    </span>
  </summary>
  <form id="preset-form" class="preset-form" novalidate>
    <fieldset
      id="preset-controls"
      class="preset-controls"
      aria-label={t('Preset options', 'Параметры пресета')}
      disabled
    >
      <Field
        id="name"
        label={t('Preset name', 'Название пресета')}
        hint={t(
          'Up to 64 characters: lowercase Latin letters, numbers and hyphens. Start with a letter or number. For example, hackathon.',
          'До 64 символов: строчные латинские буквы, цифры и дефисы. Начните с буквы или цифры. Например, hackathon.',
        )}
      >
        <input
          id="name"
          name="name"
          value="my-setup"
          maxlength="64"
          pattern="[a-z0-9][a-z0-9\-]{0,63}"
          aria-describedby="name-hint name-error"
          required
        />
      </Field>
      <fieldset data-field="process">
        <legend>
          {t(
            'How detailed should the workflow be?',
            'Насколько подробно разбивать работу на этапы?',
          )}
        </legend>
        <div class="choice-grid">
          <label class="choice">
            <input
              type="radio"
              name="process"
              value="minimal"
              aria-describedby="process-error"
            />
            <span>
              <strong>{t('Minimal', 'Минимально')}</strong>
              <small>
                {t('Only necessary stages', 'Только необходимые этапы')}
              </small>
            </span>
          </label>
          <label class="choice">
            <input
              type="radio"
              name="process"
              value="balanced"
              aria-describedby="process-error"
              checked
            />
            <span>
              <strong>{t('Moderate', 'Умеренно')}</strong>
              <small>{t('Main stages of work', 'Основные этапы работы')}</small>
            </span>
          </label>
          <label class="choice">
            <input
              type="radio"
              name="process"
              value="structured"
              aria-describedby="process-error"
            />
            <span>
              <strong>{t('Detailed', 'Подробно')}</strong>
              <small>
                {t('More intermediate stages', 'Больше промежуточных этапов')}
              </small>
            </span>
          </label>
        </div>
        <p
          id="process-error"
          class="field-error"
          data-field-error
          role="alert"
          hidden
        ></p>
      </fieldset>
      <Field id="style" label={t('Agent responses', 'Ответы агента')}>
        <Select
          id="style"
          name="style"
          label={t('Agent responses', 'Ответы агента')}
          value="concise"
          describedBy="style-error"
          options={[
            { value: 'concise', label: t('Concise', 'Коротко и по делу') },
            {
              value: 'detailed',
              label: t('Detailed', 'С подробным объяснением'),
            },
          ]}
        />
      </Field>
      <details class="advanced">
        <summary>
          {t(
            'More options: project, agents and protected files',
            'Дополнительно: проект, агенты и защищённые файлы',
          )}
        </summary>
        <div class="field-row">
          <Field
            id="language"
            label={t('Programming language', 'Язык программирования')}
          >
            <Select
              id="language"
              name="language"
              label={t('Programming language', 'Язык программирования')}
              value=""
              options={languages}
              describedBy="language-error"
            />
          </Field>
          <Field id="kind" label={t('Project type', 'Тип проектов')}>
            <Select
              id="kind"
              name="kind"
              label={t('Project type', 'Тип проектов')}
              value=""
              options={kinds}
              describedBy="kind-error"
            />
          </Field>
        </div>
        <fieldset data-field="agents">
          <legend>
            {t('Coding agents you use', 'Какими агентами вы пользуетесь')}
          </legend>
          <div class="agent-choices">
            {HARNESS_PROFILES.map(({ id, label, status }) => (
              <label>
                <input
                  type="checkbox"
                  name="agents"
                  value={id}
                  aria-describedby="agents-hint agents-error"
                />{' '}
                {label}
                {status === 'legacy' ? t(' (legacy)', ' (прежний формат)') : ''}
              </label>
            ))}
          </div>
          <small id="agents-hint">
            {t(
              'Your choices are saved in the preset but do not guarantee skill installation or loading in that environment. You can leave this empty: the agent will check your environment. Legacy formats are listed to help preserve existing setups.',
              'Выбор сохранится в пресете, но не гарантирует установку или загрузку скиллов в этой среде. Можно ничего не выбирать: агент проверит окружение сам. Устаревшие форматы указаны для сохранения существующих настроек.',
            )}
          </small>
          <p
            id="agents-error"
            class="field-error"
            data-field-error
            role="alert"
            hidden
          ></p>
        </fieldset>
        <Field
          id="custom-agents"
          name="customAgents"
          label={t('Other agent IDs', 'Идентификаторы других агентов')}
          hint={t(
            'Enter lowercase IDs separated by spaces or commas, for example team-agent. You can include up to 16 distinct IDs in total, counting those selected above. They are saved as preferences.',
            'Введите идентификаторы строчными буквами через пробел или запятую, например team-agent. Всего можно указать до 16 разных идентификаторов, включая выбранные выше. Они сохраняются как предпочтения.',
          )}
        >
          <input
            id="custom-agents"
            name="customAgents"
            placeholder="team-agent"
            autocapitalize="none"
            spellcheck="false"
            aria-describedby="custom-agents-hint custom-agents-error"
          />
        </Field>
        <Field
          id="forbidden-paths"
          name="forbiddenPaths"
          label={t(
            'Files and folders that must not change',
            'Какие файлы и папки нельзя менять',
          )}
          hint={t(
            'One path per line, relative to the project root. Include paths only, without file contents or secrets.',
            'По одному пути относительно корня проекта на строку. Указывайте только пути, без содержимого файлов и секретов.',
          )}
        >
          <textarea
            id="forbidden-paths"
            name="forbiddenPaths"
            rows="3"
            placeholder="data/raw&#10;private/"
            aria-describedby="forbidden-paths-hint forbidden-paths-error"
          ></textarea>
        </Field>
      </details>
      <p id="form-error" class="form-error" role="alert" hidden></p>
      <button
        id="download-preset"
        class="button button-primary download-button"
        type="submit"
        disabled
      >
        {t('Download preset.yaml', 'Скачать preset.yaml')}{' '}
        <span aria-hidden="true">↓</span>
      </button>
    </fieldset>
    <p class="form-footnote">
      {t(
        'In each project, the agent proposes a separate plan and waits for your approval.',
        'В каждом проекте агент предложит отдельный план и дождётся вашего согласия.',
      )}
    </p>
    <p
      id="download-status"
      class="download-status"
      role="status"
      aria-live="polite"
    ></p>
  </form>
</details>
