---
import { localize, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
---

<figure class="setup-preview" id="example" aria-labelledby="example-caption">
  <div class="repo-stage">
    <div class="repo-window">
      <div class="preview-toolbar">
        <span class="tree-folder project-folder" aria-hidden="true"></span>
        <span class="preview-project">
          next-good-idea<span class="project-slash"> /</span>
        </span>
        <span class="status-dot" aria-hidden="true"></span>
      </div>
      <div class="repo-content">
        <ul
          class="repo-tree"
          aria-label={t(
            'What Tibicen helps organize',
            'Что помогает организовать Tibicen',
          )}
        >
          <li class="proposed-file">
            <div class="tree-row">
              <span class="tree-file" aria-hidden="true"></span>
              <span class="tree-name">AGENTS.md</span>
              <span class="tree-annotation">
                {t('clear instructions', 'ясные правила')}
              </span>
            </div>
          </li>
          <li>
            <div class="tree-row">
              <span class="tree-folder" aria-hidden="true"></span>
              <span class="tree-name">
                .agents/
                <wbr />
                skills/
              </span>
              <span class="tree-annotation">
                {t('only what you need', 'только нужное')}
              </span>
            </div>
          </li>
          <li>
            <div class="tree-row">
              <svg
                class="tree-tool"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 3v4M13 3v4M5 7h10v3a5 5 0 0 1-10 0V7ZM10 15v3"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span class="tree-name">MCP</span>
              <span class="tree-annotation annotation-optional">
                {t('if needed', 'если нужно')}
              </span>
            </div>
          </li>
          <li class="project-work">
            <div class="tree-row">
              <span class="tree-folder" aria-hidden="true"></span>
              <span class="tree-name">your-work/</span>
              <span class="tree-annotation annotation-muted">
                {t('unchanged', 'без изменений')}
              </span>
            </div>
            <p class="work-contents">
              src/ · tests/ · {t('your data', 'ваши данные')}
            </p>
          </li>
        </ul>
      </div>
      <div class="repo-status">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="8" stroke="currentColor" />
          <path
            d="m6.5 10 2.3 2.3 4.7-5"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span>{t('Focus on your idea.', 'Можно заняться самой идеей.')}</span>
      </div>
    </div>
  </div>
  <figcaption id="example-caption">
    <strong>{t('Example setup.', 'Пример настройки.')}</strong>{' '}
    {t(
      'Paths and tools depend on the project and agent.',
      'Пути и состав настройки зависят от проекта и агента.',
    )}
  </figcaption>
</figure>
