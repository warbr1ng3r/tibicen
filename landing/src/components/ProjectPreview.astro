---
import { localize, type Locale } from '../i18n';
import SetupIcon from './SetupIcon.astro';
interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
const optional = [
  {
    icon: 'memory' as const,
    name: t('Memory', 'Память'),
    note: t('your decisions', 'ваши решения'),
  },
  {
    icon: 'skills' as const,
    name: t('Skills', 'Скиллы'),
    note: t('repeated tasks', 'повторные задачи'),
  },
  {
    icon: 'plug' as const,
    name: 'MCP',
    note: t('external tools', 'внешние инструменты'),
  },
];
---

<figure class="setup-preview" id="example" aria-labelledby="preview-project">
  <div class="repo-stage">
    <div class="repo-window">
      <div class="preview-toolbar">
        <SetupIcon name="folder" class="tree-icon project-folder-icon" />
        <span class="preview-project" id="preview-project">
          next-good-idea<span class="project-slash"> /</span>
        </span>
        <span class="preview-example">{t('example', 'пример')}</span>
        <span class="status-dot" aria-hidden="true"></span>
      </div>
      <div class="repo-content">
        <ul
          class="repo-tree"
          aria-label={t('One possible setup', 'Один из вариантов настройки')}
        >
          <li class="proposed-file">
            <div class="tree-row">
              <SetupIcon name="file" class="tree-icon" />
              <span class="tree-name">AGENTS.md</span>
              <span class="tree-annotation">
                {t('agent instructions', 'инструкции агенту')}
              </span>
            </div>
          </li>
          <li class="optional-setup">
            <div class="optional-heading">
              <span>{t('Optional', 'При необходимости')}</span>
              <small>{t('chosen for your project', 'под ваш проект')}</small>
            </div>
            <ul>
              {optional.map((entry) => (
                <li>
                  <div class="tree-row">
                    <SetupIcon name={entry.icon} class="tree-icon" />
                    <span class="tree-name">{entry.name}</span>
                    <span class="tree-note">{entry.note}</span>
                  </div>
                </li>
              ))}
            </ul>
          </li>
          <li data-preview-file="history">
            <div class="tree-row">
              <SetupIcon name="folderClock" class="tree-icon" />
              <span class="tree-name">.tibicen/</span>
              <span class="tree-note">
                {t('setup history', 'история настройки')}
              </span>
            </div>
          </li>
          <li class="existing-file">
            <div class="tree-row">
              <SetupIcon name="folder" class="tree-icon" />
              <span class="tree-name">src/ · tests/ · data/</span>
              <span class="tree-note">{t('unchanged', 'без изменений')}</span>
            </div>
          </li>
        </ul>
      </div>
      <div class="repo-status">
        <SetupIcon name="check" />
        <p>
          {t(
            'Only the setup your project needs.',
            'Только то, что нужно вашему проекту.',
          )}
        </p>
      </div>
    </div>
  </div>
</figure>
