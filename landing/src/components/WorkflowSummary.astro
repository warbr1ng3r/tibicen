---
import { localize, type Locale } from '../i18n';
import SetupIcon from './SetupIcon.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
const steps = [
  [
    t('The agent reads the project', 'Агент изучает проект'),
    t(
      'Reads files, finds commands and checks existing instructions',
      'Читает файлы, находит команды и проверяет существующие инструкции',
    ),
  ],
  [
    t('You review the plan', 'Вы проверяете план'),
    t(
      'See which files will change and why',
      'Видите, какие файлы изменятся и зачем',
    ),
  ],
  [
    t('The agent applies the changes', 'Агент вносит изменения'),
    t(
      'After you approve the plan, the agent applies the changes and reports what it could and could not verify',
      'После вашего согласия применяет план и сообщает, что удалось проверить и что осталось непроверенным',
    ),
  ],
];
---

<div class="setup-composition workflow-summary">
  <div class="composition-copy">
    <p class="eyebrow">{t('How it works', 'Как это работает')}</p>
    <h2 id="result-title">
      {t(
        'Tell your agent what the project needs',
        'Опишите, что нужно вашему проекту',
      )}
    </h2>
    <p>
      {t(
        'Everything happens in your agent chat, from reading the project to checking the changes.',
        'Всё происходит в чате с вашим агентом: от изучения проекта до проверки внесённых изменений.',
      )}
    </p>
    <ol class="workflow-summary-steps">
      {steps.map(([title, description], index) => (
        <li>
          <span aria-hidden="true">0{index + 1}</span>
          <div>
            <strong>{title}</strong>
            <p>{description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <div
    class="setup-dialog"
    aria-label={t('Illustrative conversation', 'Учебный диалог')}
  >
    <div class="dialog-content">
      <p class="dialog-speaker you-label">{t('You', 'Вы')}</p>
      <blockquote class="request-bubble">
        {t('Set this up for my agent.', 'Настрой проект для моего агента.')}
      </blockquote>
      <p class="dialog-speaker agent-label">
        <span class="agent-mark" aria-hidden="true">
          t
        </span>
        {t('Your agent + Tibicen', 'Ваш агент + Tibicen')}
      </p>
      <p class="dialog-reply">
        {t(
          'I’ll read the project and show you a plan first. I won’t change the application code.',
          'Сначала изучу проект и покажу план. Код приложения менять не буду.',
        )}
      </p>
      <div class="proposal-paper">
        <p class="proposal-heading">{t('Example plan', 'Пример плана')}</p>
        <div class="proposed-line">
          <b aria-hidden="true">+</b>
          <SetupIcon name="file" />
          <code>AGENTS.md</code>
          <span>{t('instructions', 'инструкции')}</span>
        </div>
        <div class="proposed-line">
          <b aria-hidden="true">+</b>
          <SetupIcon name="folderClock" />
          <code>.tibicen/</code>
          <span>{t('setup history', 'история настройки')}</span>
        </div>
      </div>
    </div>
    <div class="dialog-footer">
      <SetupIcon name="check" />
      <p>
        {t(
          'Changes begin after your approval',
          'Изменения начнутся после вашего согласия',
        )}
      </p>
    </div>
  </div>
</div>
