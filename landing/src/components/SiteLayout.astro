---
import { localize, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  locale: Locale;
  preset?: boolean;
}
const { locale, preset = false } = Astro.props;
const t = (en: string, ru: string) => localize(locale, en, ru);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${basePath}/${locale === 'ru' ? 'ru/' : ''}`;
const repository = 'https://github.com/warbr1ng3r/tibicen';
const guide = `${repository}/blob/main/README.md`;
const title = preset
  ? t('Tibicen — save your preferences', 'Tibicen — сохраните предпочтения')
  : t(
      'Tibicen — set up your project for AI coding',
      'Tibicen — подготовьте проект к работе с агентом',
    );
const description = preset
  ? t(
      'Save reusable preferences for your coding agent. Build and download a Tibicen preset locally in your browser.',
      'Сохраните предпочтения для агента. Соберите и скачайте пресет Tibicen локально в браузере.',
    )
  : t(
      'Set up project instructions and only the tools your coding agent needs. Review the exact plan before changes and receive a clear verification report.',
      'Настройте инструкции проекта и только нужные агенту инструменты. Сначала согласуйте точный план, затем получите изменения и понятный отчёт о проверках.',
    );
const english = new URL(`${basePath}/${preset ? 'preset/' : ''}`, Astro.site);
const russian = new URL(
  `${basePath}/ru/${preset ? 'preset/' : ''}`,
  Astro.site,
);
const canonical = locale === 'ru' ? russian : english;
const preview = new URL(`${basePath}/assets/social-preview.png`, Astro.site);
const previewAlt = t(
  'Tibicen: project instructions with optional memory and tools.',
  'Tibicen: инструкции проекта с необязательной памятью и инструментами.',
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1c1c1c" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={english.href} />
    <link rel="alternate" hreflang="ru" href={russian.href} />
    <link rel="alternate" hreflang="x-default" href={english.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tibicen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'ru' ? 'en_US' : 'ru_RU'}
    />
    <meta property="og:image" content={preview.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={previewAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview.href} />
    <meta name="twitter:image:alt" content={previewAlt} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${basePath}/assets/favicon.svg`}
    />
    <script src="../scripts/app.ts"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('Skip to content', 'К содержимому')}
    </a>
    <header class="header page-width">
      <a
        class="wordmark"
        href={home}
        aria-label={t('Tibicen — home', 'Tibicen — главная')}
      >
        <img
          class="brand-mark"
          src={`${basePath}/assets/logo.svg`}
          width="36"
          height="36"
          alt=""
        />
        tibicen
      </a>
      <nav aria-label={t('Main navigation', 'Основная навигация')}>
        <a href={`${home}#start`}>{t('Get started', 'Начать')}</a>
        <a href={`${home}#result`}>{t('Example', 'Пример')}</a>
        <a href={`${home}#faq`}>{t('Questions', 'Вопросы')}</a>
      </nav>
      <div
        class="language-switch"
        role="group"
        aria-label={t('Page language', 'Язык страницы')}
      >
        <a
          href={`${basePath}/${preset ? 'preset/' : ''}`}
          hreflang="en"
          lang="en"
          aria-label="English"
          aria-current={locale === 'en' ? 'page' : undefined}
        >
          EN
        </a>
        <a
          href={`${basePath}/ru/${preset ? 'preset/' : ''}`}
          hreflang="ru"
          lang="ru"
          aria-label="Русский"
          aria-current={locale === 'ru' ? 'page' : undefined}
        >
          RU
        </a>
      </div>
      <a class="header-start" href={`${home}#start`}>
        {t('Install', 'Установить')} <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer page-width">
      <a
        class="wordmark"
        href={home}
        aria-label={t('Tibicen — home', 'Tibicen — главная')}
      >
        <img
          class="brand-mark"
          src={`${basePath}/assets/logo.svg`}
          width="28"
          height="28"
          alt=""
        />
        tibicen
      </a>
      <div class="project-links">
        <a href={repository}>GitHub</a>
        <a href={guide}>{t('Documentation', 'Документация')}</a>
        <a href={`${repository}/blob/main/LICENSE`}>MIT</a>
      </div>
    </footer>
    <p
      id="copy-status"
      class="copy-status"
      role="status"
      aria-live="polite"
    ></p>
    <noscript>
      <p class="noscript-note">
        {t(
          'Installation commands, prompts and language links work without JavaScript. Enable JavaScript to copy text or download a preset.',
          'Команды установки, запросы и ссылки языка работают без JavaScript. Для копирования и скачивания пресета включите JavaScript.',
        )}
      </p>
    </noscript>
  </body>
</html>
